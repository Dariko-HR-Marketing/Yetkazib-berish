# Production environment variables for Dostavka
POSTGRES_PASSWORD=your_strong_postgres_password
APP_DB_PASSWORD=your_strong_app_db_password
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
DATA_ENCRYPTION_KEY=your_base64_32_byte_encryption_key
PHONE_HASH_PEPPER=your_phone_hash_pepper_at_least_16_chars
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Sinov rejimi (xavfsiz emas): to'g'ridan-to'g'ri telefon bilan kirish
OPEN_LOGIN=on
OPEN_LOGIN_CONFIRM=I-UNDERSTAND-NO-AUTH
