# Nusxa oling: cp .env.example .env  — haqiqiy sirlarni repoga qo'ymang (CLAUDE.md §9).

NODE_ENV=development
PORT=4000

# Migratsiyalar va seed uchun (egasi roli)
DATABASE_URL=postgresql://dostavka:dostavka@127.0.0.1:5432/dostavka
# Ilova uchun (RLS ta'sir qiladigan rol: BYPASSRLS yo'q). Parol migratsiya CLI'sida APP_DB_PASSWORD bilan o'rnatiladi.
APP_DATABASE_URL=postgresql://dostavka_app:dostavka_app@127.0.0.1:5432/dostavka
APP_DB_PASSWORD=dostavka_app
REDIS_URL=redis://127.0.0.1:6379/0

# Productionda majburiy va dev qiymatlardan farqli bo'lishi shart (config.ts tekshiradi)
JWT_SECRET=change-me-at-least-32-characters-long-secret
DATA_ENCRYPTION_KEY=          # 32 bayt, base64:  openssl rand -base64 32
PHONE_HASH_PEPPER=change-me-pepper-0123456789
TELEGRAM_BOT_TOKEN=           # BotFather (O12)

SMS_PROVIDER=mock             # Eskiz / Play Mobile (O10) tanlangach adapter qo'shiladi
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EVENTS_DISPATCH=off           # on: outbox -> BullMQ dispatcher
DEV_SMS_INBOX=off             # faqat e2e: mock SMS qutisini HTTP orqali o'qish (productionda yoqib bo'lmaydi)

# apps/web
API_URL=http://127.0.0.1:4000 # Next.js /v1/* so'rovlarini shu manzilga proksilaydi (build vaqtida o'qiladi)
