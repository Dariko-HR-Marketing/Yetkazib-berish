# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env faylini hech qachon git'ga qo'shmang.

# --- Muhit ---
APP_ENV=development            # development | staging | production
APP_BASE_URL=http://localhost:8000
DEFAULT_LOCALE=uz
TIME_ZONE=Asia/Tashkent

# --- Ma'lumotlar bazasi ---
POSTGRES_DB=dariko
POSTGRES_USER=dariko
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://dariko:change_me_strong_password@postgres:5432/dariko

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Fayl saqlash (S3-mos) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=dariko_minio
S3_SECRET_KEY=change_me_minio_secret
S3_BUCKET=dariko-media

# --- Xavfsizlik ---
JWT_SECRET=change_me_long_random_string
TRACKING_TOKEN_TTL_HOURS=24
OTP_TTL_SECONDS=300
IDEMPOTENCY_TTL_HOURS=24

# --- Biznes sozlamalari (standart qiymatlar) ---
RESERVE_TTL_MINUTES=15
SUBSTITUTION_REPLY_TIMEOUT_SEC=300
CONSENT_INCREASE_PCT_DEFAULT=10
OUTBOX_MAX_ATTEMPTS=10

# --- To'lov (G1 da bittasi tanlanadi; sinov kalitlari) ---
PAYMENT_PROVIDER=payme         # payme | click
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Xabarnoma (G1 da bittasi tanlanadi) ---
MESSAGE_PROVIDER=telegram      # telegram | sms
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_LOGIN=
SMS_PROVIDER_PASSWORD=

# --- Xarita ---
YANDEX_GEOCODER_API_KEY=

# --- Kuzatuv ---
SENTRY_DSN=
LOG_LEVEL=info
