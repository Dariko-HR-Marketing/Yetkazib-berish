{
  "name": "@dostavka/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "openapi"],
  "scripts": {
    "gen": "openapi-typescript openapi/openapi.yaml -o src/schema.ts",
    "build": "pnpm gen && tsc -p tsconfig.json",
    "typecheck": "pnpm gen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test && redocly lint openapi/openapi.yaml",
    "test": "vitest run"
  },
  "dependencies": { "yaml": "^2.6.0" },
  "devDependencies": {
    "@dostavka/config": "workspace:*",
    "@redocly/cli": "^1.25.0",
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.14.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "yaml": "^2.6.0"
  }
}
