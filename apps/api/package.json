{
  "name": "@dostavka/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:reset": "tsx src/db/reset-cli.ts"
  },
  "dependencies": {
    "@dostavka/contracts": "workspace:*",
    "@dostavka/i18n": "workspace:*",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "bullmq": "^5.25.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "otpauth": "^9.3.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dostavka/config": "workspace:*",
    "@nestjs/testing": "^10.4.8",
    "@swc/core": "^1.9.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.5"
  }
}